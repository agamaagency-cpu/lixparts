{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lixparts",
  "compatibility_date": "2026-08-26",
  // Сайт собирается статикой (next.config.mjs: output: "export") — в out/ лежат готовые HTML.
  // Серверный код один: worker/index.ts принимает заявки POST /api/lead (Telegram + почта).
  // run_worker_first ограничен /api/*, поэтому все страницы по-прежнему отдаются прямо из ассетов.
  "main": "worker/index.ts",
  // Переменные (TG_CHAT_ID, LEAD_EMAIL_TO…) задаются в панели Cloudflare. Без keep_vars
  // каждый деплой из GitHub стирал бы их, потому что в этом файле их нет. Секреты сохраняются в любом случае.
  "keep_vars": true,
  // Не секретные настройки заявок. Токен бота — секрет TG_BOT_TOKEN, задаётся только в панели Cloudflare.
  "vars": {
    "TG_CHAT_ID": "-5391800382"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
